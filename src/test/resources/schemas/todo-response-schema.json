  "type": "object",
  "required": ["id", "todo", "completed"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "todo": { "type": "string", "minLength": 1 },
    "completed": { "type": "boolean" }
  },
  "additionalProperties": true
}
